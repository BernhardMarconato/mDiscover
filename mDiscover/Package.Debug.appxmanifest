      <uap:VisualElements DisplayName="ms-resource:App_Title_Dev" Description="ms-resource:App_Description" BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
