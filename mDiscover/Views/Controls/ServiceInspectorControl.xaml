<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="mDiscover.Views.Controls.ServiceInspectorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:mDiscover.Behaviors"
    xmlns:controls="using:mDiscover.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:mDiscover.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:labs="using:CommunityToolkit.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:mDiscover.Core.Models"
    xmlns:strings="using:mDiscover.Strings"
    xmlns:vm="using:mDiscover.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <!--  Empty Details State  -->
        <Grid
            Margin="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RowSpacing="8"
            Visibility="{x:Bind ViewModel, Mode=OneWay, Converter={StaticResource InverseNullToVisConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <FontIcon
                Grid.Row="0"
                HorizontalAlignment="Center"
                FontSize="44"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="{x:Bind helpers:FluentGlyphs.InspectorEmpty}" />
            <TextBlock
                Grid.Row="1"
                HorizontalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="{x:Bind strings:Resources.Inspector_EmptyTitle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Row="2"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{x:Bind strings:Resources.Inspector_EmptySubtitle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Grid>

        <!--  Selected Service Inspector (Fills Full Available Column Width)  -->
        <ScrollViewer HorizontalAlignment="Stretch" Visibility="{x:Bind ViewModel, Mode=OneWay, Converter={StaticResource NullToVisConverter}}">
            <Grid
                Margin="24,20,24,24"
                HorizontalAlignment="Stretch"
                RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  1. Hero Summary Card (Responsive RelativePanel Layout)  -->
                <Border
                    Grid.Row="0"
                    Padding="16"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <RelativePanel x:Name="HeroSummaryPanel" SizeChanged="OnHeroSummaryPanelSizeChanged">

                        <Border
                            x:Name="HeroIconBorder"
                            Width="44"
                            Height="44"
                            Margin="0,0,16,0"
                            VerticalAlignment="Top"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            RelativePanel.AlignLeftWithPanel="True"
                            RelativePanel.AlignTopWithPanel="True">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="{x:Bind ViewModel.ServiceType, Mode=OneWay, Converter={StaticResource ServiceTypeToGlyphConverter}}" />
                        </Border>

                        <StackPanel
                            x:Name="HeroDetailsStack"
                            VerticalAlignment="Top"
                            RelativePanel.AlignTopWithPanel="True"
                            RelativePanel.LeftOf="ServiceCopySplitButton"
                            RelativePanel.RightOf="HeroIconBorder"
                            Spacing="4">
                            <!--  InstanceName + Inline Online Badge (RichTextBlock with Paragraph)  -->
                            <RichTextBlock
                                x:Name="HeroInstanceNameTextBlock"
                                FontSize="20"
                                FontWeight="SemiBold"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap">
                                <Paragraph>
                                    <Run Text="{x:Bind ViewModel.InstanceName, Mode=OneWay}" />
                                    <InlineUIContainer>
                                        <Border
                                            x:Name="HeroOnlineBadge"
                                            Margin="4,1,0,0"
                                            Padding="6,2,6,2"
                                            VerticalAlignment="Center"
                                            Background="{x:Bind helpers:ServiceDisplayFormatter.GetServiceStatusBadgeBackground(ViewModel.IsOnline, ViewModel.ResolutionStatus), Mode=OneWay}"
                                            CornerRadius="{ThemeResource ControlCornerRadius}">
                                            <TextBlock
                                                FontWeight="Bold"
                                                Foreground="{x:Bind helpers:ServiceDisplayFormatter.GetServiceStatusBadgeForeground(ViewModel.IsOnline, ViewModel.ResolutionStatus), Mode=OneWay}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind helpers:ServiceDisplayFormatter.FormatServiceStatusBadgeText(ViewModel.IsOnline, ViewModel.ResolutionStatus), Mode=OneWay}"
                                                TextTrimming="None"
                                                TextWrapping="NoWrap" />
                                        </Border>
                                    </InlineUIContainer>
                                </Paragraph>
                            </RichTextBlock>

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.DisplayType, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontFamily="Cascadia Code, Consolas"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.FullServicePath, Mode=OneWay}"
                                TextWrapping="Wrap"
                                ToolTipService.ToolTip="{x:Bind strings:Resources.Inspector_FullServiceDomainTooltip}" />
                        </StackPanel>

                        <!--  Device Export SplitButton  -->
                        <SplitButton
                            x:Name="ServiceCopySplitButton"
                            Margin="16,4,0,0"
                            VerticalAlignment="Top"
                            Command="{x:Bind ViewModel.CopyCommand, Mode=OneWay}"
                            RelativePanel.AlignRightWithPanel="True"
                            RelativePanel.AlignTopWithPanel="True"
                            ToolTipService.ToolTip="{x:Bind helpers:ServiceDisplayFormatter.FormatInstanceCopyTooltip(ViewModel.SelectedCopyFormat), Mode=OneWay}">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    FontSize="13"
                                    Glyph="{x:Bind helpers:FluentGlyphs.Copy}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind strings:Resources.Copy_ButtonLabel}" />
                                <TeachingTip
                                    x:Name="InspectorCopyToastTip"
                                    Title="{x:Bind strings:Resources.Export_ToastTitle}"
                                    IsLightDismissEnabled="True"
                                    IsOpen="{x:Bind ViewModel.IsCopyNotificationOpen, Mode=TwoWay}"
                                    PreferredPlacement="Bottom"
                                    Subtitle="{x:Bind helpers:ServiceDisplayFormatter.FormatExportNotification(1, ViewModel.SelectedCopyFormat), Mode=OneWay}"
                                    Target="{x:Bind ServiceCopySplitButton}">
                                    <TeachingTip.IconSource>
                                        <FontIconSource Glyph="{x:Bind helpers:FluentGlyphs.Copy}" />
                                    </TeachingTip.IconSource>
                                </TeachingTip>
                            </Grid>
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem
                                        Command="{x:Bind ViewModel.CopyCommand, Mode=OneWay}"
                                        CommandParameter="{x:Bind models:ExportFormat.Text}"
                                        Text="{x:Bind strings:Resources.Format_Text}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="{x:Bind helpers:FluentGlyphs.ExportText}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Command="{x:Bind ViewModel.CopyCommand, Mode=OneWay}"
                                        CommandParameter="{x:Bind models:ExportFormat.Markdown}"
                                        Text="{x:Bind strings:Resources.Format_Markdown}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="{x:Bind helpers:FluentGlyphs.ExportMarkdown}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Command="{x:Bind ViewModel.CopyCommand, Mode=OneWay}"
                                        CommandParameter="{x:Bind models:ExportFormat.Csv}"
                                        Text="{x:Bind strings:Resources.Format_Csv}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="{x:Bind helpers:FluentGlyphs.ExportCsv}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Command="{x:Bind ViewModel.CopyCommand, Mode=OneWay}"
                                        CommandParameter="{x:Bind models:ExportFormat.Json}"
                                        Text="{x:Bind strings:Resources.Format_Json}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="{x:Bind helpers:FluentGlyphs.ExportJson}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                    </RelativePanel>
                </Border>

                <!--  2. Network Endpoint & Addressing Details  -->
                <Border
                    Grid.Row="1"
                    Padding="16"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" VerticalAlignment="Center">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind strings:Resources.Inspector_NetworkEndpoint}" />
                        </Grid>

                        <!--  Resolution Warning InfoBar  -->
                        <InfoBar
                            Title="{x:Bind strings:Resources.Inspector_ResolutionFailed}"
                            Grid.Row="1"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.IsResolutionFailed, Mode=OneWay}"
                            Message="{x:Bind helpers:ServiceDisplayFormatter.FormatResolutionError(ViewModel.FailureReason, ViewModel.HostName, ViewModel.FailureDetails), Mode=OneWay}"
                            Severity="Warning"
                            Visibility="{x:Bind ViewModel.IsResolutionFailed, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                            <i:Interaction.Behaviors>
                                <behaviors:SelectableInfoBarMessageBehavior />
                            </i:Interaction.Behaviors>
                            <InfoBar.ActionButton>
                                <Button
                                    Command="{x:Bind ViewModel.RetryResolveCommand, Mode=OneWay}"
                                    Content="{x:Bind strings:Resources.Action_Retry}"
                                    Style="{ThemeResource AccentButtonStyle}" />
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <Grid
                            Grid.Row="2"
                            ColumnSpacing="16"
                            RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Host & Domain  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind strings:Resources.Inspector_HostAndDomain}" />
                            <Grid
                                Grid.Row="0"
                                Grid.Column="1"
                                MinHeight="20"
                                VerticalAlignment="Center">
                                <labs:Shimmer
                                    Width="160"
                                    Height="20"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    IsActive="{x:Bind ViewModel.IsResolvingHost, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsResolvingHost, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                <RichTextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Code, Consolas"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.IsResolvingHost, Mode=OneWay, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <Paragraph>
                                        <Run Text="{x:Bind helpers:ServiceDisplayFormatter.FormatHost(ViewModel.HostName, ViewModel.ResolutionStatus), Mode=OneWay}" />
                                        <InlineUIContainer>
                                            <FontIcon
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="{x:Bind helpers:FluentGlyphs.Info}"
                                                ToolTipService.ToolTip="{x:Bind strings:Resources.Inspector_FallbackResolutionTooltip}"
                                                Visibility="{x:Bind ViewModel.IsFallbackResolution, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                        </InlineUIContainer>
                                    </Paragraph>
                                </RichTextBlock>
                            </Grid>

                            <!--  Primary Endpoint  -->
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind strings:Resources.Inspector_PrimaryEndpoint}" />
                            <Grid
                                Grid.Row="1"
                                Grid.Column="1"
                                MinHeight="24"
                                VerticalAlignment="Center">
                                <labs:Shimmer
                                    Width="140"
                                    Height="20"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    IsActive="{x:Bind ViewModel.IsResolvingEndpoint, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsResolvingEndpoint, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                <RelativePanel
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.IsResolvingEndpoint, Mode=OneWay, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <TextBlock
                                        x:Name="PrimaryEndpointTextBlock"
                                        VerticalAlignment="Center"
                                        FontFamily="Cascadia Code, Consolas"
                                        IsTextSelectionEnabled="True"
                                        RelativePanel.AlignLeftWithPanel="True"
                                        RelativePanel.AlignVerticalCenterWithPanel="True"
                                        Text="{x:Bind helpers:ServiceDisplayFormatter.FormatEndpoint(ViewModel.FormattedEndpoint, ViewModel.ResolutionStatus), Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="OpenEndpointInBrowserButton"
                                        Margin="6,0,0,0"
                                        Padding="4"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.OpenInBrowserCommand, Mode=OneWay}"
                                        RelativePanel.AlignVerticalCenterWithPanel="True"
                                        RelativePanel.RightOf="PrimaryEndpointTextBlock"
                                        Style="{ThemeResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="{x:Bind strings:Resources.Action_Browse}"
                                        Visibility="{x:Bind ViewModel.CanOpenInBrowser, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                        <FontIcon FontSize="11" Glyph="{x:Bind helpers:FluentGlyphs.ExternalLink}" />
                                    </Button>
                                </RelativePanel>
                            </Grid>

                            <!--  IP Addresses  -->
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,4,0,0"
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind strings:Resources.Inspector_IpAddresses}" />

                            <!--  Resolved IPs  -->
                            <ItemsControl
                                Grid.Row="2"
                                Grid.Column="1"
                                ItemsSource="{x:Bind ViewModel.AllIpAddresses, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasIpAddresses, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:IpAddressDisplayItem">
                                        <Grid Margin="0,2,0,2" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Grid.Column="0"
                                                Padding="6,2,6,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind ProtocolVersion}" />
                                            </Border>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontFamily="Cascadia Code, Consolas"
                                                IsTextSelectionEnabled="True"
                                                Style="{ThemeResource BodyTextBlockStyle}"
                                                Text="{x:Bind Address}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--  Resolving IPs Shimmer State  -->
                            <labs:Shimmer
                                Grid.Row="2"
                                Grid.Column="1"
                                Width="120"
                                Height="24"
                                Margin="0,2,0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                IsActive="{x:Bind ViewModel.IsResolvingIpAddresses, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsResolvingIpAddresses, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />

                            <!--  No IPs / Failed State  -->
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind strings:Resources.Inspector_NoIpAddressesFound}"
                                Visibility="{x:Bind ViewModel.IsResolutionFailed, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                        </Grid>
                    </Grid>
                </Border>

                <!--  3. DNS-SD Text Attributes (TXT Records)  -->
                <Border
                    Grid.Row="2"
                    Padding="16"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel
                            Grid.Row="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind strings:Resources.Inspector_TxtAttributes}" />
                            <Border
                                Padding="6,1,6,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.TxtRecords.Count, Mode=OneWay}" />
                            </Border>
                        </StackPanel>

                        <!--  TXT Records List  -->
                        <ItemsControl
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.TxtRecords, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasTxtRecords, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:TxtRecordItem">
                                    <Grid Margin="0,4,0,4" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Padding="6,2,6,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource ControlCornerRadius}">
                                            <TextBlock
                                                FontFamily="Cascadia Code, Consolas"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                IsTextSelectionEnabled="True"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Key}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontFamily="Cascadia Code, Consolas"
                                            IsTextSelectionEnabled="True"
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            Text="{x:Bind Value}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  No TXT Records State  -->
                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind strings:Resources.Inspector_NoTxtAttributes}"
                            Visibility="{x:Bind ViewModel.HasTxtRecords, Mode=OneWay, Converter={StaticResource InverseBoolToVisConverter}}" />
                    </Grid>
                </Border>

                <!--  4. Discovery & Activity  -->
                <Border
                    Grid.Row="3"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind strings:Resources.Inspector_Activity}" />

                        <Grid
                            Grid.Row="1"
                            ColumnSpacing="16"
                            RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind strings:Resources.Inspector_FirstSeen}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontFamily="Cascadia Code, Consolas"
                                IsTextSelectionEnabled="True"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind helpers:ServiceDisplayFormatter.FormatTimeDetailed(ViewModel.FirstSeen), Mode=OneWay}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind strings:Resources.Inspector_LastSeen}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontFamily="Cascadia Code, Consolas"
                                IsTextSelectionEnabled="True"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind helpers:ServiceDisplayFormatter.FormatTimeDetailed(ViewModel.LastSeen), Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HeroCardResponsiveStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.Setters>
                        <Setter Target="HeroDetailsStack.(RelativePanel.LeftOf)" Value="ServiceCopySplitButton" />
                        <Setter Target="HeroDetailsStack.(RelativePanel.AlignRightWithPanel)" Value="False" />
                        <Setter Target="ServiceCopySplitButton.(RelativePanel.AlignRightWithPanel)" Value="True" />
                        <Setter Target="ServiceCopySplitButton.(RelativePanel.AlignTopWithPanel)" Value="True" />
                        <Setter Target="ServiceCopySplitButton.(RelativePanel.Below)" Value="" />
                        <Setter Target="ServiceCopySplitButton.(RelativePanel.AlignLeftWith)" Value="" />
                        <Setter Target="ServiceCopySplitButton.Margin" Value="16,4,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.Setters>
                        <Setter Target="HeroDetailsStack.(RelativePanel.LeftOf)" Value="" />
                        <Setter Target="HeroDetailsStack.(RelativePanel.AlignRightWithPanel)" Value="True" />
                        <Setter Target="ServiceCopySplitButton.(RelativePanel.AlignRightWithPanel)" Value="False" />
                        <Setter Target="ServiceCopySplitButton.(RelativePanel.AlignTopWithPanel)" Value="False" />
                        <Setter Target="ServiceCopySplitButton.(RelativePanel.Below)" Value="HeroDetailsStack" />
                        <Setter Target="ServiceCopySplitButton.(RelativePanel.AlignLeftWith)" Value="HeroDetailsStack" />
                        <Setter Target="ServiceCopySplitButton.Margin" Value="0,12,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
