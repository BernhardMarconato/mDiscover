<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="mDiscover.Views.Controls.ServiceCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:mDiscover.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:mDiscover.Helpers"
    xmlns:labs="using:CommunityToolkit.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:mDiscover.Core.Models"
    xmlns:strings="using:mDiscover.Strings"
    xmlns:vm="using:mDiscover.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="0,8,4,8" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.CopyCommand, Mode=OneWay}"
                    CommandParameter="{x:Bind models:ExportFormat.Text}"
                    Text="{x:Bind strings:Resources.Copy_AsText}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="{x:Bind helpers:FluentGlyphs.ExportText}" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.CopyCommand, Mode=OneWay}"
                    CommandParameter="{x:Bind models:ExportFormat.Markdown}"
                    Text="{x:Bind strings:Resources.Copy_AsMarkdown}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="{x:Bind helpers:FluentGlyphs.ExportMarkdown}" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.CopyCommand, Mode=OneWay}"
                    CommandParameter="{x:Bind models:ExportFormat.Csv}"
                    Text="{x:Bind strings:Resources.Copy_AsCsv}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="{x:Bind helpers:FluentGlyphs.ExportCsv}" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.CopyCommand, Mode=OneWay}"
                    CommandParameter="{x:Bind models:ExportFormat.Json}"
                    Text="{x:Bind strings:Resources.Copy_AsJson}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="{x:Bind helpers:FluentGlyphs.ExportJson}" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <Border
            Grid.Column="0"
            Width="32"
            Height="32"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource ControlCornerRadius}">
            <FontIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                Glyph="{x:Bind ViewModel.ServiceType, Mode=OneWay, Converter={StaticResource ServiceTypeToGlyphConverter}}" />
        </Border>

        <Grid Grid.Column="1" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.InstanceName, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <Grid Grid.Row="1" Margin="0,4,0,0">
                <labs:Shimmer
                    Width="110"
                    Height="12"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    IsActive="{x:Bind ViewModel.IsResolvingIpAddresses, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsResolvingIpAddresses, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind helpers:ServiceDisplayFormatter.FormatCardSubtitle(ViewModel.ServiceType, ViewModel.FormattedEndpoint, ViewModel.ResolutionStatus), Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind helpers:ServiceDisplayFormatter.FormatCardSubtitle(ViewModel.ServiceType, ViewModel.FormattedEndpoint, ViewModel.ResolutionStatus), Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsResolvingIpAddresses, Mode=OneWay, Converter={StaticResource InverseBoolToVisConverter}}" />
            </Grid>
        </Grid>

        <Ellipse
            Grid.Column="2"
            Width="8"
            Height="8"
            Margin="0,0,4,0"
            VerticalAlignment="Center"
            Fill="{x:Bind helpers:ServiceDisplayFormatter.GetServiceStatusDotBrush(ViewModel.IsOnline, ViewModel.ResolutionStatus), Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind helpers:ServiceDisplayFormatter.GetServiceStatusTooltip(ViewModel.IsOnline, ViewModel.ResolutionStatus), Mode=OneWay}" />
    </Grid>
</UserControl>
