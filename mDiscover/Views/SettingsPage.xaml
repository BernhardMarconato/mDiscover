<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="mDiscover.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:mDiscover.Helpers"
    xmlns:interfaces="using:mDiscover.Core.Interfaces"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:strings="using:mDiscover.Strings"
    xmlns:vm="using:mDiscover.ViewModels"
    mc:Ignorable="d">

    <Border
        Margin="12,0,12,12"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource OverlayCornerRadius}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="900"
                Margin="32,24,32,32"
                HorizontalAlignment="Stretch"
                Spacing="24">

                <!--  Top Header  -->
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind strings:Resources.Settings_Title}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind strings:Resources.Settings_Subtitle}" />
                </StackPanel>

                <!--  1. Appearance & Theme Section (Placed at Top)  -->
                <StackPanel Spacing="8">
                    <TextBlock
                        Margin="4,0,0,0"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind strings:Resources.Settings_AppearanceHeader}" />

                    <controls:SettingsCard Description="{x:Bind strings:Resources.Settings_ThemeDescription}" Header="{x:Bind strings:Resources.Settings_ThemeCard}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="{x:Bind helpers:FluentGlyphs.Theme}" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="220" SelectedIndex="{x:Bind ViewModel.Settings.SelectedThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{x:Bind strings:Resources.Theme_System}" />
                            <ComboBoxItem Content="{x:Bind strings:Resources.Theme_Light}" />
                            <ComboBoxItem Content="{x:Bind strings:Resources.Theme_Dark}" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <!--  Restart Notice when Theme is modified  -->
                    <Border
                        Padding="12,8,12,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Visibility="{x:Bind ViewModel.Settings.IsRestartBannerVisible, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Grid.Column="0"
                                FontSize="16"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="{x:Bind helpers:FluentGlyphs.Info}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind strings:Resources.Theme_RestartRequired}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="RestartAppButton"
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.Settings.RestartAppCommand}"
                                Content="{x:Bind strings:Resources.Theme_RestartButton}"
                                Style="{ThemeResource AccentButtonStyle}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  2. Discovery Engine Section  -->
                <StackPanel Spacing="8">
                    <TextBlock
                        Margin="4,0,0,0"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind strings:Resources.Settings_DiscoveryEngineHeader}" />

                    <!--  SettingsCard: Active Provider  -->
                    <controls:SettingsCard Description="{x:Bind strings:Resources.Settings_ActiveEngineDescription}" Header="{x:Bind strings:Resources.Settings_ActiveEngineCard}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="{x:Bind helpers:FluentGlyphs.RemoteAccess}" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="220" SelectedIndex="{x:Bind ViewModel.Settings.ActiveProviderIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{x:Bind strings:Resources.Provider_Win32}" />
                            <ComboBoxItem Content="{x:Bind strings:Resources.Provider_WinRt}" />
                            <ComboBoxItem Content="{x:Bind strings:Resources.Provider_Fake}" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <!--  SettingsExpander: Discovery Approach  -->
                    <controls:SettingsExpander
                        Description="{x:Bind strings:Resources.Settings_DiscoveryModeDescription}"
                        Header="{x:Bind strings:Resources.Settings_DiscoveryModeHeader}"
                        IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="{x:Bind helpers:FluentGlyphs.Network}" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Description="{x:Bind strings:Resources.Settings_UniversalWildcardDescription}" Header="{x:Bind strings:Resources.Settings_UniversalWildcardHeader}">
                                <RadioButton
                                    GroupName="DiscoveryModeGroup"
                                    IsChecked="{x:Bind ViewModel.Settings.IsWildcardMode, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.Settings.IsWildcardSupported, Mode=OneWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Description="{x:Bind strings:Resources.Settings_TargetedCatalogDescription}" Header="{x:Bind strings:Resources.Settings_TargetedCatalogHeader}">
                                <RadioButton GroupName="DiscoveryModeGroup" IsChecked="{x:Bind ViewModel.Settings.IsTargetedMode, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Description="{x:Bind strings:Resources.Settings_HybridDiscoveryDescription}" Header="{x:Bind strings:Resources.Settings_HybridDiscoveryHeader}">
                                <RadioButton
                                    GroupName="DiscoveryModeGroup"
                                    IsChecked="{x:Bind ViewModel.Settings.IsHybridMode, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.Settings.IsWildcardSupported, Mode=OneWay}" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                </StackPanel>

                <!--  3. Service Catalog Section  -->
                <StackPanel Spacing="8">
                    <TextBlock
                        Margin="4,0,0,0"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind strings:Resources.Settings_CatalogHeader}" />

                    <!--  Custom Service Types Expander (Includes Add Input & Configured Custom Items)  -->
                    <controls:SettingsExpander
                        Description="{x:Bind strings:Resources.Settings_CustomServicesDescription}"
                        Header="{x:Bind strings:Resources.Settings_CustomServicesCard}"
                        IsExpanded="True"
                        ItemsSource="{x:Bind ViewModel.Settings.CustomServiceTypes}">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="{x:Bind helpers:FluentGlyphs.DeveloperCode}" />
                        </controls:SettingsExpander.HeaderIcon>

                        <!--  Header Action: Clear All Custom Types (visible when custom types exist)  -->
                        <controls:SettingsExpander.Content>
                            <Button
                                x:Name="ResetCustomServicesButton"
                                Command="{x:Bind ViewModel.Settings.ResetCustomServiceTypesCommand}"
                                ToolTipService.ToolTip="{x:Bind strings:Resources.Settings_ResetCustomServices}"
                                Visibility="{x:Bind ViewModel.Settings.CustomServiceTypes.Count, Mode=OneWay, Converter={StaticResource CountToVisConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="{x:Bind helpers:FluentGlyphs.Delete}" />
                                    <TextBlock Text="{x:Bind strings:Resources.Settings_ResetCustomServices}" />
                                </StackPanel>
                            </Button>
                        </controls:SettingsExpander.Content>

                        <controls:SettingsExpander.ItemsHeader>
                            <!--  Add Custom Service Card  -->
                            <controls:SettingsCard Description="{x:Bind strings:Resources.Settings_AddCustomServiceDescription}" Header="{x:Bind strings:Resources.Settings_AddCustomServiceCard}">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="{x:Bind helpers:FluentGlyphs.Add}" />
                                </controls:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox
                                        Width="220"
                                        PlaceholderText="_myservice._tcp"
                                        Text="{x:Bind ViewModel.Settings.CustomServiceTypeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        x:Name="AddCustomServiceButton"
                                        Command="{x:Bind ViewModel.Settings.AddCustomServiceTypeCommand}"
                                        Content="{x:Bind strings:Resources.Settings_AddServiceButton}"
                                        Style="{ThemeResource AccentButtonStyle}" />
                                </StackPanel>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.ItemsHeader>

                        <controls:SettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServiceTypeConfigViewModel">
                                <controls:SettingsCard
                                    HorizontalAlignment="Stretch"
                                    Description="{x:Bind ServiceType}"
                                    Header="{x:Bind DisplayName}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                                        <Button
                                            Padding="8,6"
                                            VerticalAlignment="Center"
                                            Command="{x:Bind RemoveCommand}"
                                            ToolTipService.ToolTip="{x:Bind strings:Resources.Settings_DeleteCustomTypeTooltip}">
                                            <FontIcon FontSize="12" Glyph="{x:Bind helpers:FluentGlyphs.Delete}" />
                                        </Button>
                                    </StackPanel>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </controls:SettingsExpander.ItemTemplate>
                    </controls:SettingsExpander>

                    <!--  Built-in Service Catalog Expander  -->
                    <controls:SettingsExpander
                        Description="{x:Bind strings:Resources.Settings_BuiltInServicesDescription}"
                        Header="{x:Bind strings:Resources.Settings_BuiltInServicesCard}"
                        ItemsSource="{x:Bind ViewModel.Settings.BuiltInServiceTypes}">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="{x:Bind helpers:FluentGlyphs.Folder}" />
                        </controls:SettingsExpander.HeaderIcon>

                        <!--  Header Actions: Select All / Deselect All  -->
                        <controls:SettingsExpander.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="SelectAllServicesButton"
                                    Command="{x:Bind ViewModel.Settings.SelectAllServiceTypesCommand}"
                                    Content="{x:Bind strings:Resources.Settings_SelectAll}" />
                                <Button
                                    x:Name="DeselectAllServicesButton"
                                    Command="{x:Bind ViewModel.Settings.DeselectAllServiceTypesCommand}"
                                    Content="{x:Bind strings:Resources.Settings_DeselectAll}" />
                            </StackPanel>
                        </controls:SettingsExpander.Content>

                        <controls:SettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServiceTypeConfigViewModel">
                                <controls:SettingsCard
                                    HorizontalAlignment="Stretch"
                                    Description="{x:Bind ServiceType}"
                                    Header="{x:Bind DisplayName}">
                                    <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                                </controls:SettingsCard>
                            </DataTemplate>
                        </controls:SettingsExpander.ItemTemplate>
                    </controls:SettingsExpander>
                </StackPanel>

                <!--  4. About & App Info Section  -->
                <StackPanel Spacing="8">
                    <TextBlock
                        Margin="4,0,0,0"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind strings:Resources.Settings_AboutHeader}" />

                    <controls:SettingsExpander
                        Description="{x:Bind strings:Resources.About_Copyright}"
                        Header="{x:Bind strings:Resources.App_Title}"
                        IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="{x:Bind helpers:FluentGlyphs.Info}" />
                        </controls:SettingsExpander.HeaderIcon>

                        <controls:SettingsExpander.Content>
                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.Settings.ShortAppVersion}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.Settings.AppVersion}" />
                            </StackPanel>
                        </controls:SettingsExpander.Content>

                        <controls:SettingsExpander.Items>
                            <!--  GitHub Repository  -->
                            <controls:SettingsCard Header="{x:Bind strings:Resources.About_GitHubRepo}">
                                <HyperlinkButton NavigateUri="https://github.com/BernhardMarconato/mDiscover">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="BernhardMarconato/mDiscover" />
                                        <FontIcon FontSize="12" Glyph="{x:Bind helpers:FluentGlyphs.ExternalLink}" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </controls:SettingsCard>

                            <!--  License  -->
                            <controls:SettingsCard Description="{x:Bind strings:Resources.About_LicenseValue}" Header="{x:Bind strings:Resources.About_License}">
                                <HyperlinkButton NavigateUri="https://github.com/BernhardMarconato/mDiscover/blob/main/LICENSE">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind strings:Resources.About_ViewLicense}" />
                                        <FontIcon FontSize="12" Glyph="{x:Bind helpers:FluentGlyphs.ExternalLink}" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </controls:SettingsCard>

                            <!--  Third-Party Notices  -->
                            <controls:SettingsCard Header="{x:Bind strings:Resources.About_ThirdPartyLicenses}">
                                <HyperlinkButton
                                    x:Name="OpenLicensesFolderButton"
                                    Command="{x:Bind ViewModel.Settings.OpenLicensesFolderCommand}"
                                    Content="{x:Bind strings:Resources.Action_ViewLicenses}" />
                            </controls:SettingsCard>

                            <!--  Diagnostic Logs  -->
                            <controls:SettingsCard Header="{x:Bind strings:Resources.About_LogFolder}">
                                <HyperlinkButton
                                    x:Name="OpenLogFolderButton"
                                    Command="{x:Bind ViewModel.Settings.OpenLogFolderCommand}"
                                    Content="{x:Bind strings:Resources.Action_OpenLogs}" />
                            </controls:SettingsCard>

                            <!--  Privacy Policy  -->
                            <controls:SettingsCard Header="{x:Bind strings:Resources.About_PrivacyPolicy}">
                                <HyperlinkButton NavigateUri="https://github.com/BernhardMarconato/mDiscover/blob/main/PRIVACY.md">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind strings:Resources.About_ViewPrivacyPolicy}" />
                                        <FontIcon FontSize="12" Glyph="{x:Bind helpers:FluentGlyphs.ExternalLink}" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Page>
